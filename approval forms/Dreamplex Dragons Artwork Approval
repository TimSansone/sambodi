
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Artwork Proof Approval</title>
  <style>
    :root{color-scheme:light;--ink:#17212f;--muted:#647084;--line:#d9e2ee;--panel:#fff;--soft:#f4f8fb;--teal:#0f766e;--blue:#2f6fca;--amber:#d9951f;--shadow:0 18px 48px rgba(23,33,47,.13);font-family:Arial,Helvetica,sans-serif}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:linear-gradient(135deg,rgba(15,118,110,.12),transparent 34%),linear-gradient(45deg,rgba(47,111,202,.11),transparent 30%),#eef3f7;color:var(--ink)}button,input,textarea{font:inherit}.page{width:min(1240px,100%);margin:0 auto;padding:clamp(12px,3vw,24px)}header{display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:18px;align-items:end;margin-bottom:18px}h1{margin:0;font-size:clamp(2rem,4vw,4.2rem);line-height:.98;letter-spacing:0}.subtitle{margin:8px 0 0;color:var(--muted);line-height:1.45}.brand{min-width:230px;padding:14px 16px;border:1px solid var(--line);border-radius:8px;background:var(--panel);box-shadow:var(--shadow);text-align:center}.brand strong{display:block;font-size:1.35rem}.brand span{color:var(--muted);font-size:.78rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}main{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.75fr);gap:18px;align-items:start}.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow)}.pad{padding:16px}h2{margin:0 0 12px;font-size:1.18rem}.proof-head{display:flex;justify-content:space-between;gap:12px;align-items:start;padding:16px;border-bottom:1px solid var(--line)}.meta{display:flex;flex-wrap:wrap;gap:8px;color:var(--muted);font-size:.9rem;font-weight:800}.pill{padding:7px 9px;border:1px solid var(--line);border-radius:999px;background:#fbfcfe}.proof-stage{min-height:610px;display:grid;place-items:center;background:#fbfdff;overflow:hidden}.proof-stage img{display:block;max-width:100%;max-height:610px;object-fit:contain}.details{display:grid;gap:8px;padding:14px 16px;border-top:1px solid var(--line)}.detail{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--line)}.detail:last-child{border-bottom:0}.detail span{color:var(--muted);font-weight:800}.detail strong{text-align:right;overflow-wrap:anywhere}label{display:block;margin-bottom:7px;color:var(--muted);font-size:.78rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}input,textarea{width:100%;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);padding:10px 11px;outline:none}textarea{min-height:104px;resize:vertical;line-height:1.45}.choices{display:grid;gap:10px}.choice{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:start;padding:12px;border:1px solid var(--line);border-radius:8px;background:#fbfcfe;cursor:pointer}.choice input{width:auto;margin-top:2px}.choice strong{display:block}.choice span span{display:block;margin-top:3px;color:var(--muted);font-size:.88rem;line-height:1.35}.approved{border-color:rgba(4,120,87,.35)}.revision{border-color:rgba(217,149,31,.42)}.terms{padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--soft);color:var(--muted);line-height:1.42;font-size:.92rem}.btn{min-height:44px;border:0;border-radius:8px;padding:10px 13px;cursor:pointer;color:#fff;background:var(--teal);font-weight:900}.btn.secondary{background:var(--blue)}.btn.warning{background:var(--amber);color:#241800}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.status{min-height:42px;padding:11px 12px;border:1px solid var(--line);border-radius:8px;background:#f8fbfd;color:var(--muted);line-height:1.4}.response{display:grid;gap:14px}@media(max-width:920px){header,main{grid-template-columns:1fr}.brand{min-width:0}.proof-stage{min-height:420px}.proof-stage img{max-height:420px}}@media(max-width:560px){.page{padding:10px}h1{font-size:2rem}.proof-head,.actions{display:grid;grid-template-columns:1fr}input,textarea,.btn{min-height:46px;font-size:16px}}@media print{body{background:#fff;color:#111827}.page{width:100%;padding:0}header{border-bottom:2px solid #111827;padding-bottom:14px}main{display:block}.panel{box-shadow:none;border:0}.actions,.status{display:none}.proof-stage{min-height:auto;border:1px solid #d1d5db;background:#fff;page-break-inside:avoid}.proof-stage img{max-height:620px}.response{margin-top:18px}}
  </style>
</head>
<body>
  <div class="page">
    <header>
      <div>
        <h1>Artwork Approval</h1>
        <p class="subtitle">Please review the proof carefully. If everything looks correct, choose Approved for Production. If changes are needed, choose Request Changes and list the changes in the comments box.</p>
      </div>
      <div class="brand"><strong>Sambodi Creations</strong><span>Proof approval</span></div>
    </header>
    <main>
      <section class="panel">
        <div class="proof-head">
          <div>
            <h2>Artwork Proof</h2>
            <div class="meta">
              <span class="pill">Customer: -</span>
              <span class="pill">Proof #: PROOF-1001</span>
              <span class="pill">Date: 6/20/2026</span>
            </div>
          </div>
          <button class="btn secondary" id="printBtn" type="button">Print Copy</button>
        </div>
        <div class="proof-stage"><img src="data:image/png;base64," alt="Artwork proof"></div>
        <div class="details">
          <div class="detail"><span>Product details</span><strong>-</strong></div>
        </div>
      </section>
      <aside class="panel pad response">
        <h2>Approval Response</h2>
        <div class="choices">
          <label class="choice approved"><input type="radio" name="approvalStatus" value="Approved"><span><strong>Approved for Production</strong><span>I approve this artwork as shown.</span></span></label>
          <label class="choice revision"><input type="radio" name="approvalStatus" value="Needs Revision"><span><strong>Request Changes</strong><span>I need changes before production begins.</span></span></label>
        </div>
        <div><label for="notes">Comments or requested changes</label><textarea id="notes" placeholder="List any requested changes or approval comments."></textarea></div>
        <div><label for="signature">Typed signature</label><input id="signature" type="text" placeholder="Type your name"></div>
        <div class="terms">By approving, you confirm that spelling, artwork, color expectations, placement, and sizing have been reviewed. Production may begin after approval.</div>
        <div class="actions">
          <button class="btn" id="emailBtn" type="button">Email Response</button>
          <button class="btn warning" id="downloadBtn" type="button">Download Copy</button>
        </div>
        <div class="status" id="status">Choose approved or request changes, then email your response.</div>
      </aside>
    </main>
  </div>
  <script>
    const businessEmail="info@sambodicreations.com";
    const proofNumber="PROOF-1001";
    const jobName="";
    const generatedDate="6/20/2026";
    function selectedStatus(){return document.querySelector('input[name="approvalStatus"]:checked')?.value||""}
    function responseText(){return ["Artwork Approval Response","=========================", "Customer: -", "Job / order: "+(jobName||"-"), "Proof #: "+(proofNumber||"-"), "Date: "+generatedDate, "", "Response: "+(selectedStatus()||"-"), "Typed signature: "+(document.getElementById("signature").value.trim()||"-"), "", "Comments / requested changes:", document.getElementById("notes").value.trim()||"-", "", "Approval statement:", "By approving, the customer confirms that spelling, artwork, color expectations, placement, and sizing have been reviewed."].join("\n")}
    document.getElementById("emailBtn").addEventListener("click",()=>{const status=document.getElementById("status");if(!selectedStatus()){status.textContent="Please choose Approved for Production or Request Changes before emailing.";return}const subject=encodeURIComponent("Artwork Approval Response - "+(proofNumber||jobName||"Proof"));const body=encodeURIComponent(responseText());window.location.href="mailto:"+businessEmail+"?subject="+subject+"&body="+body;status.textContent="Your email app should open with the approval response filled in."});
    document.getElementById("downloadBtn").addEventListener("click",()=>{const blob=new Blob([responseText()],{type:"text/plain"});const url=URL.createObjectURL(blob);const link=document.createElement("a");link.href=url;link.download=((proofNumber||"artwork-approval").replace(/[^a-z0-9-]+/gi,"-").replace(/^-|-$/g,"")||"artwork-approval")+"-response.txt";document.body.appendChild(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);document.getElementById("status").textContent="Approval response downloaded."});
    document.getElementById("printBtn").addEventListener("click",()=>window.print());
  </script>
</body>
</html>
